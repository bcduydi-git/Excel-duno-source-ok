	partition tblHopDong = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\DuNo\Du_lieu_dau_vao_du_no.xlsx"), null, true),
				    tblHopDong_Table = Source{[Item="tblHopDong",Kind="Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(tblHopDong_Table,{{"MaCongTy", type text}, {"MaHDTD", type text}, {"MaNganHang", type text}, {"NgayHieuLuc", type date}, {"NgayHetHan", type date}, {"HanMucTong", Int64.Type}, {"TSDB", type text}, {"MucDichVay", type text}, {"GhiChu", type any}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

