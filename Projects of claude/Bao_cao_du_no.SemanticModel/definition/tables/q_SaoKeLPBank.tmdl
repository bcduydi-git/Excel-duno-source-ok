		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition q_SaoKeLPBank = m
		mode: import
		source =
				let
				    ThuMuc =
				        "C:\DuNo\SaoKe\HP\LPBank",
				
				    Chu = (x as any) as text =>
				        if x = null then "" else Text.Trim(Text.From(x)),
				
				    SoTien = (x as any) as number =>
				        if x = null or Chu(x) = "" then 0
				        else if x is number then x
				        else Number.FromText(Chu(x), "en-US"),
				
				    DocFile = (
				        NoiDungFile as binary,
				        TenFile as text,
				        DuongDan as text
				    ) as table =>
				        let
				            Workbook = Excel.Workbook(NoiDungFile, null, true),
				
				            Sheet = Workbook{
				                [Item = "Lịch sử giao dịch", Kind = "Sheet"]
				            }[Data],
				
				            // Giữ số dòng Excel để truy vết
				            DanhSoDong = Table.AddIndexColumn(
				                Sheet, "DongNguon", 1, 1, Int64.Type
				            ),
				
				            // Dòng giao dịch có STT bằng số
				            LocGiaoDich = Table.SelectRows(
				                DanhSoDong,
				                each
				                    let
				                        STT = Chu([Column1])
				                    in
				                        STT <> ""
				                        and Text.Select(STT, {"0".."9"}) = STT
				            ),
				
				            ChonCot = Table.SelectColumns(
				                LocGiaoDich,
				                {
				                    "DongNguon",
				                    "Column1",
				                    "Column2",
				                    "Column3",
				                    "Column6",
				                    "Column7",
				                    "Column8",
				                    "Column9",
				                    "Column13",
				                    "Column14",
				                    "Column16"
				                }
				            ),
				
				            DoiTen = Table.RenameColumns(
				                ChonCot,
				                {
				                    {"Column1", "STT"},
				                    {"Column2", "NgayGiaoDich"},
				                    {"Column3", "NoiDung"},
				                    {"Column6", "SoGiaoDich"},
				                    {"Column7", "GhiNo"},
				                    {"Column8", "GhiCo"},
				                    {"Column9", "SoDuTaiKhoan"},
				                    {"Column13", "TaiKhoanDoiUng"},
				                    {"Column14", "TenDoiUng"},
				                    {"Column16", "NganHangDoiUng"}
				                }
				            ),
				
				            ChuanHoa = Table.TransformColumns(
				                DoiTen,
				                {
				                    {"STT", each Int64.From(_), Int64.Type},
				                    {
				                        "NgayGiaoDich",
				                        each
				                            if _ is text then
				                                Date.From(
				                                    DateTime.FromText(
				                                        Text.Trim(_),
				                                        [Culture = "vi-VN"]
				                                    )
				                                )
				                            else Date.From(_),
				                        type date
				                    },
				                    {"NoiDung", Chu, type text},
				                    {"SoGiaoDich", Chu, type text},
				                    {"GhiNo", SoTien, type number},
				                    {"GhiCo", SoTien, type number},
				                    {"SoDuTaiKhoan", SoTien, type number},
				                    {"TaiKhoanDoiUng", Chu, type text},
				                    {"TenDoiUng", Chu, type text},
				                    {"NganHangDoiUng", Chu, type text}
				                }
				            ),
				
				            ThemTenFile = Table.AddColumn(
				                ChuanHoa, "TenFileNguon", each TenFile, type text
				            ),
				
				            ThemID = Table.AddColumn(
				            ThemTenFile,
				            "IDGiaoDich",
				            each
				                "HP|LPBank|"
				                & TenFile
				                & "|"
				                & Text.From([DongNguon], "en-US"),
				            type text
				        )
				        in
				            ThemID,
				
				    DanhSachFile = Folder.Files(ThuMuc),
				
				    LocFile = Table.SelectRows(
				        DanhSachFile,
				        each
				            Text.Lower([Extension]) = ".xlsx"
				            and not Text.StartsWith([Name], "~$")
				            and [Attributes]?[Hidden]? <> true
				    ),
				
				    DocCacFile = Table.AddColumn(
				        LocFile,
				        "DuLieu",
				        each DocFile([Content], [Name], [Folder Path])
				    ),
				
				    GopFile =
				        if Table.IsEmpty(LocFile) then
				            error "Folder chưa có file sao kê .xlsx."
				        else
				            Table.Combine(DocCacFile[DuLieu]),
				
				    ThemCongTy = Table.AddColumn(
				        GopFile, "MaCongTy", each "HP", type text
				    ),
				
				    ThemNganHangSaoKe = Table.AddColumn(
				        ThemCongTy, "NganHangSaoKe", each "LPBank", type text
				    ),
				
				    // LD2600918367 hoặc PDLD2600918367;8
				    ThemMaKheUoc = Table.AddColumn(
				        ThemNganHangSaoKe,
				        "MaKheUoc",
				        each
				            let
				                Ref = Text.Upper([SoGiaoDich]),
				                BoHauTo = Text.BeforeDelimiter(Ref & ";", ";"),
				                Ma =
				                    if Text.StartsWith(BoHauTo, "PDLD") then
				                        Text.Range(BoHauTo, 2)
				                    else BoHauTo
				            in
				                if Text.StartsWith(Ma, "LD")
				                    and Text.Length(Ma) = 12
				                    and Text.Select(
				                        Text.Range(Ma, 2), {"0".."9"}
				                    ) = Text.Range(Ma, 2)
				                then Ma
				                else null,
				        type nullable text
				    ),
				
				    ThemPhanLoai = Table.AddColumn(
				        ThemMaKheUoc,
				        "PhanLoai",
				        each
				            let
				                ND = Text.Upper([NoiDung]),
				                CoMa = [MaKheUoc] <> null
				            in
				                if [GhiNo] <= 0 then "KHAC"
				                else if Text.StartsWith(ND, "THU GOC KHE UOC")
				                    and CoMa then "GOC"
				                else if Text.StartsWith(ND, "THU LAI KHE UOC")
				                    and CoMa then "LAI_PHI"
				                else if
				                    Text.Contains(ND, "CHUYEN NO QUA HAN")
				                    or Text.Contains(ND, "GOC VA LAI")
				                    or Text.Contains(ND, "THU GOC")
				                    or Text.Contains(ND, "THU LAI")
				                    or CoMa
				                then "CHO_AI"
				                else "KHAC",
				        type text
				    ),
				
				    // Ngân hàng cho vay khác với ngân hàng xuất sao kê
				    ThemNganHangVay = Table.AddColumn(
				        ThemPhanLoai,
				        "MaNganHang",
				        each if [MaKheUoc] <> null then "LPBank" else null,
				        type nullable text
				    ),
				
				    ThemGoc = Table.AddColumn(
				        ThemNganHangVay,
				        "GocDaTra",
				        each
				            if [PhanLoai] = "GOC" then [GhiNo]
				            else if [PhanLoai] = "LAI_PHI" then 0
				            else null,
				        type nullable number
				    ),
				
				    ThemLaiPhi = Table.AddColumn(
				        ThemGoc,
				        "LaiPhiDaTra",
				        each
				            if [PhanLoai] = "LAI_PHI" then [GhiNo]
				            else if [PhanLoai] = "GOC" then 0
				            else null,
				        type nullable number
				    ),
				
				    KetQua = Table.Sort(
				        ThemLaiPhi,
				        {
				            {"NgayGiaoDich", Order.Ascending},
				            {"TenFileNguon", Order.Ascending},
				            {"DongNguon", Order.Ascending}
				        }
				    )
				in
				    KetQua

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

