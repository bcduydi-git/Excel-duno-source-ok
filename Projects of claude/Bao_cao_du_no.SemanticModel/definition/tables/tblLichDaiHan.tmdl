table tblLichDaiHan
	lineageTag: 92b7efd4-5967-451c-8ea3-4b035ff81039

	column MaCongTy
		dataType: string
		lineageTag: e121ad25-4253-4a9b-99b5-e10e6c19f19b
		summarizeBy: none
		sourceColumn: MaCongTy

