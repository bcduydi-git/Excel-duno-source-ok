	column MaNganHang
		dataType: string
		lineageTag: c5f11d96-225e-4828-b6ad-804dafcaafb8
		summarizeBy: none
		sourceColumn: MaNganHang

		annotation SummarizationSetBy = Automatic

	column MaKheUoc
		dataType: string
		lineageTag: aada01dd-dbef-4ee2-bf3e-09db1fba3dec
		summarizeBy: none
		sourceColumn: MaKheUoc

		annotation SummarizationSetBy = Automatic

	column KyTraNo
		dataType: int64
		formatString: 0
		lineageTag: 050f69b4-9b2c-4b6b-88ee-392c272be309
		summarizeBy: sum
		sourceColumn: KyTraNo

		annotation SummarizationSetBy = Automatic

	column NgayDenHan
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: d4f46729-a95f-4d42-8bba-f3a0477977e3
		summarizeBy: none
		sourceColumn: NgayDenHan

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column DuNoTheoLichDauKy
		dataType: int64
		formatString: #,0
		lineageTag: b29cacbc-6d79-4597-8558-397dc9d1f88d
		summarizeBy: sum
		sourceColumn: DuNoTheoLichDauKy

		annotation SummarizationSetBy = Automatic

	column GocPhaiTra
