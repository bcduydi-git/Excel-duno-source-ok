	column LaiPhiDaTra
		dataType: decimal
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: e5af0d5c-79e9-4441-8df5-f28044107bc2
		summarizeBy: sum
