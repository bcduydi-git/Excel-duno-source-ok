		lineageTag: 33e674c3-0367-40e5-9b65-06cbe2127d7c
		summarizeBy: none
		sourceColumn: MaKheUoc

		annotation SummarizationSetBy = Automatic

	column PhanLoai
		dataType: string
		lineageTag: 9eeebdcb-291c-46d7-bb89-aa3e52944521
		summarizeBy: none
		sourceColumn: PhanLoai

		annotation SummarizationSetBy = Automatic

