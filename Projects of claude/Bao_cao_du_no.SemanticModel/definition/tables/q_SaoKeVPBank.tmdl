		lineageTag: 56037f8f-0ead-4a87-a7e6-d6666a104ad6
		summarizeBy: none
		sourceColumn: MaNganHang

		annotation SummarizationSetBy = Automatic

	column GocDaTra
		dataType: decimal
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 96482e0c-5153-4a16-8ed6-1ae9a66b6988
		summarizeBy: sum
		sourceColumn: GocDaTra

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	column LaiPhiDaTra
		dataType: decimal
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 74ce96bc-a458-4cf0-a53f-23c8479058bf
		summarizeBy: sum
		sourceColumn: LaiPhiDaTra

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	partition q_SaoKeVPBank = m
		mode: import
		source =
				let
				    ThuMuc = "C:\DuNo\SaoKe\HP\VPBank",
				
				    Chu = (x as any) as text =>
				        if x = null then ""
				        else Text.Trim(Text.From(x)),
				
				    Chuan = (x as any) as text =>
				        Text.Upper(
				            Text.Trim(
				                Text.Replace(
				                    Text.Replace(Chu(x), "#(cr)", " "),
				                    "#(lf)", " "
				                )
				            )
				        ),
				
				        SoTien = (x as any) as number =>
				        let
				            S = Text.Replace(
				                Text.Replace(Chu(x), " ", ""),
				                Character.FromNumber(160), ""
				            ),
				            DauCham = Text.PositionOf(S, ".", Occurrence.Last),
				            DauPhay = Text.PositionOf(S, ",", Occurrence.Last),
				            VanHoa =
				                if DauCham >= 0 and DauPhay >= 0 then
				                    if DauPhay > DauCham then "vi-VN"
				                    else "en-US"
				                else if DauCham >= 0 then
				                    if List.Count(Text.Split(S, ".")) > 2 then
				                        "vi-VN"
				                    else if Text.Length(Text.AfterDelimiter(S, ".")) = 3 then
				                        "vi-VN"
				                    else
				                        "en-US"
				                else if DauPhay >= 0 then
				                    if List.Count(Text.Split(S, ",")) > 2 then
				                        "en-US"
				                    else if Text.Length(Text.AfterDelimiter(S, ",")) = 3 then
				                        "en-US"
				                    else
				                        "vi-VN"
				                else "en-US"
				        in
				            if S = "" then 0
				            else if x is number then x
				            else Number.FromText(S, VanHoa),
				
				    Ngay = (x as any) as nullable date =>
				        if Chu(x) = "" then null
				        else if x is text then
				            Date.FromText(Chu(x), [Culture = "vi-VN"])
				        else Date.From(x),
				
				    // Xác định hàng tiêu đề từ nội dung thực tế.
				    ViTriTieuDe = (Bang as table) as number =>
				        let
				            CacDong = Table.ToRows(Table.FirstN(Bang, 40)),
				            DanhDau = List.Transform(
				                CacDong,
				                (Dong) =>
				                    let
				                        ND = List.Transform(Dong, each Chuan(_))
				                    in
				                        List.AnyTrue(
				                            List.Transform(
				                                ND,
				                                each Text.Contains(_, "NỘI DUNG GIAO DỊCH")
				                            )
				                        )
				                        and List.AnyTrue(
				                            List.Transform(
				                                ND,
				                                each Text.Contains(_, "SỐ TIỀN GHI NỢ")
				                            )
				                        )
				            )
				        in
				            List.PositionOf(DanhDau, true),
				
				    DocFile = (NoiDungFile as binary, TenFile as text) as table =>
				        let
				            Workbook = Excel.Workbook(NoiDungFile, null, true),
				
				            // Không yêu cầu workbook phải có Item hoặc Kind.
				            CacBang = List.Select(
				                Table.ToRecords(Workbook),
				                each Value.Is(
				                    Record.FieldOrDefault(_, "Data", null),
				                    type table
				                )
				            ),
				
				            UngVien = List.Transform(
				                CacBang,
				                (R) =>
				                    [
				                        Ten = Chu(
				                            Record.FieldOrDefault(
				                                R,
				                                "Item",
				                                Record.FieldOrDefault(R, "Name", "")
				                            )
				                        ),
				                        Bang = Record.Field(R, "Data"),
				                        ViTri = ViTriTieuDe(Record.Field(R, "Data"))
				                    ]
				            ),
				
				            BangHopLe = List.Select(
				                UngVien, each [ViTri] >= 0
				            ),
				
				            UuTien = List.Select(
				                BangHopLe, each Chuan([Ten]) = "TỔNG HỢP"
				            ),
				
				            ChonBang =
				                if List.Count(UuTien) > 0 then UuTien{0}
				                else if List.Count(BangHopLe) > 0 then BangHopLe{0}
				                else
				                    error Error.Record(
				                        "KhongTimThayBangSaoKe",
				                        "Không tìm thấy tiêu đề giao dịch VPBank trong file.",
				                        [TenFile = TenFile]
				                    ),
				
				            Bang = ChonBang[Bang],
				            ViTri = ChonBang[ViTri],
				            TenCot = Table.ColumnNames(Bang),
				
				            TieuDe = List.Transform(
				                Table.ToRows(
				                    Table.Range(Bang, ViTri, 1)
				                ){0},
				                each Chuan(_)
				            ),
				
				            TimCot = (Nhan as text) as text =>
				                let
				                    ViTriCot = List.PositionOf(
				                        List.Transform(
				                            TieuDe,
				                            each Text.StartsWith(_, Chuan(Nhan))
				                        ),
				                        true
				                    )
				                in
				                    if ViTriCot < 0 then
				                        error Error.Record(
				                            "ThieuCot",
				                            "Không tìm thấy cột " & Nhan,
				                            [TenFile = TenFile]
				                        )
				                    else TenCot{ViTriCot},
				
				            CotSTT = TimCot("STT"),
				            CotSoGD = TimCot("Số bút toán"),
				            CotNgay = TimCot("Ngày giá trị"),
				            CotCo = TimCot("Số tiền ghi có"),
				            CotNo = TimCot("Số tiền ghi nợ"),
				            CotND = TimCot("Nội dung giao dịch"),
				            CotDu = TimCot("Số dư tham chiếu"),
				            CotGio = TimCot("Thời gian giao dịch"),
				
				            DanhSoDong = Table.AddIndexColumn(
				                Bang, "DongNguon", 1, 1, Int64.Type
				            ),
				
				            LocGiaoDich = Table.SelectRows(
				                Table.Skip(DanhSoDong, ViTri + 1),
				                each
				                    let
				                        STT = Chu(Record.Field(_, CotSTT))
				                    in
				                        STT <> ""
				                        and Text.Select(STT, {"0".."9"}) = STT
				            ),
				
				            ChonCot = Table.SelectColumns(
				                LocGiaoDich,
				                {
				                    "DongNguon", CotSTT, CotSoGD, CotNgay,
				                    CotCo, CotNo, CotND, CotDu, CotGio
				                }
				            ),
				
				            DoiTen = Table.RenameColumns(
				                ChonCot,
				                {
				                    {CotSTT, "STT"},
				                    {CotSoGD, "SoGiaoDich"},
				                    {CotNgay, "NgayGiaTri"},
				                    {CotCo, "GhiCo"},
				                    {CotNo, "GhiNo"},
				                    {CotND, "NoiDung"},
				                    {CotDu, "SoDuTaiKhoan"},
				                    {CotGio, "ThoiGianGiaoDich"}
				                }
				            ),
				
				            ChuanHoa = Table.TransformColumns(
				                DoiTen,
				                {
				                    {"STT", each Int64.From(_), Int64.Type},
				                    {"SoGiaoDich", Chu, type text},
				                    {"NgayGiaTri", Ngay, type date},
				                    {"GhiCo", SoTien, Currency.Type},
				                    {"GhiNo", SoTien, Currency.Type},
				                    {"NoiDung", Chu, type text},
				                    {"SoDuTaiKhoan", SoTien, Currency.Type},
				                    {
				                        "ThoiGianGiaoDich",
				                        each
				                            if Chu(_) = "" then null
				                            else if _ is text then
				                                DateTime.FromText(
				                                    Chu(_), [Culture = "vi-VN"]
				                                )
				                            else DateTime.From(_),
				                        type nullable datetime
				                    }
				                }
				            ),
				
				            ThemNgay = Table.AddColumn(
				                ChuanHoa,
				                "NgayGiaoDich",
				                each
				                    if [ThoiGianGiaoDich] = null then [NgayGiaTri]
				                    else Date.From([ThoiGianGiaoDich]),
				                type date
				            ),
				
				            ThemFile = Table.AddColumn(
				                ThemNgay, "TenFileNguon",
				                each TenFile, type text
				            ),
				
				            ThemID = Table.AddColumn(
				                ThemFile,
				                "IDGiaoDich",
				                each
				                    "HP|VPBank|" & TenFile
				                    & "|" & Text.From([DongNguon]),
				                type text
				            )
				        in
				            ThemID,
				
				    LocFile = Table.SelectRows(
				        Folder.Files(ThuMuc),
				        each
				            Text.Lower([Extension]) = ".xlsx"
				            and not Text.StartsWith([Name], "~$")
				            and [Attributes]?[Hidden]? <> true
				    ),
				
				    DocCacFile = Table.AddColumn(
				        LocFile, "DuLieu",
				        each DocFile([Content], [Name])
				    ),
				
				    GopFile =
				        if Table.IsEmpty(LocFile) then
				            error "Folder VPBank chưa có file sao kê .xlsx."
				        else Table.Combine(DocCacFile[DuLieu]),
				
				    ThemCongTy = Table.AddColumn(
				        GopFile, "MaCongTy", each "HP", type text
				    ),
				
				    ThemNganHangSaoKe = Table.AddColumn(
				        ThemCongTy, "NganHangSaoKe",
				        each "VPBank", type text
				    ),
				
				    ThemMaKheUoc = Table.AddColumn(
				        ThemNganHangSaoKe,
				        "MaKheUoc",
				        each
				            let
				                Ref = Text.Upper([SoGiaoDich]),
				                BoHauTo = Text.BeforeDelimiter(Ref & ";", ";"),
				                Ma =
				                    if Text.StartsWith(BoHauTo, "PDLD") then
				                        Text.Range(BoHauTo, 2)
				                    else BoHauTo
				            in
				                if Text.StartsWith(Ma, "LD")
				                    and Text.Length(Ma) = 12
				                    and Text.Select(
				                        Text.Range(Ma, 2), {"0".."9"}
				                    ) = Text.Range(Ma, 2)
				                then Ma
				                else null,
				        type nullable text
				    ),
				
				    ThemPhanLoai = Table.AddColumn(
				        ThemMaKheUoc,
				        "PhanLoai",
				        each
				            let
				                ND = Chuan([NoiDung]),
				                CoMa = [MaKheUoc] <> null,
				                LaGoc =
				                    Text.StartsWith(ND, "THANH TOAN GOC")
				                    or Text.StartsWith(ND, "THANH TOAN NO GOC"),
				                LaLai = Text.StartsWith(ND, "THANH TOAN LAI"),
				                GopGocLai =
				                    Text.Contains(ND, "GOC VA LAI")
				                    or Text.Contains(ND, "GỐC VÀ LÃI")
				            in
				                if [GhiNo] <= 0 then "KHAC"
				                else if GopGocLai then "CHO_AI"
				                else if LaGoc and CoMa then "GOC"
				                else if LaLai and CoMa then "LAI_PHI"
				                else if
				                    CoMa or LaGoc or LaLai
				                    or Text.Contains(ND, "THU NO")
				                    or Text.Contains(ND, "THU GOC")
				                    or Text.Contains(ND, "THU LAI")
				                then "CHO_AI"
				                else "KHAC",
				        type text
				    ),
				
				    ThemNganHangVay = Table.AddColumn(
				        ThemPhanLoai,
				        "MaNganHang",
				        each if [MaKheUoc] <> null then "VPBank" else null,
				        type nullable text
				    ),
				
				    ThemGoc = Table.AddColumn(
				        ThemNganHangVay,
				        "GocDaTra",
				        each
				            if [PhanLoai] = "GOC" then [GhiNo]
				            else if [PhanLoai] = "LAI_PHI" then 0
				            else null,
				        Currency.Type
				    ),
				
				    ThemLaiPhi = Table.AddColumn(
				        ThemGoc,
				        "LaiPhiDaTra",
				        each
				            if [PhanLoai] = "LAI_PHI" then [GhiNo]
				            else if [PhanLoai] = "GOC" then 0
				            else null,
				        Currency.Type
				    ),
				
				    KetQua = Table.Sort(
				        ThemLaiPhi,
				        {
				            {"NgayGiaoDich", Order.Ascending},
				            {"TenFileNguon", Order.Ascending},
				            {"DongNguon", Order.Ascending}
				        }
				    )
				in
				    KetQua

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

