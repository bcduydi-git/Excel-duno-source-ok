	column NgayBatDauTheoDoi
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 52b24d3e-cda3-470b-b649-2fdd772eebe4
		summarizeBy: none
		sourceColumn: NgayBatDauTheoDoi

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition tblKheUoc = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\DuNo\Du_lieu_dau_vao_du_no.xlsx"), null, true),
				
				    DuLieu = Source{[Item="tblKheUoc", Kind="Table"]}[Data],
				
				    ChuanHoaChu = Table.TransformColumns(
				        DuLieu,
				        List.Transform(
				            {
				                "MaCongTy",
				                "MaNganHang",
				                "MaKheUoc",
				                "MaHDTD",
				                "PhuongThucTraGoc",
				                "TanSuatTraGoc",
				                "TanSuatTraLai"
				            },
				            (Cot) => {
				                Cot,
				                each
				                    if _ = null then null
				                    else
				                        let
				                            Chu = Text.Trim(Text.From(_))
				                        in
				                            if Chu = "" then null else Chu,
				                type nullable text
				            }
				        )
				    ),
				
				    ChuanHoaNgayTrong = Table.TransformColumns(
				        ChuanHoaChu,
				        List.Transform(
				            {
				                "NgayNhanNo",
				                "NgayDaoHan",
				                "NgayTraGocDauTien",
				                "NgayTraLaiDauTien"
				            },
				            (Cot) => {
				                Cot,
				                each
				                    if _ is text then
				                        if Text.Trim(_) = "" then null else _
				                    else _,
				                type any
				            }
				        )
				    ),
				
				    DinhDangDuLieu = Table.TransformColumnTypes(
				        ChuanHoaNgayTrong,
				        {
				            {"MaCongTy", type text},
				            {"MaNganHang", type text},
				            {"MaKheUoc", type text},
				            {"MaHDTD", type text},
				            {"NgayNhanNo", type date},
				            {"NgayDaoHan", type date},
				            {"SoTienVay", Int64.Type},
				            {"LaiSuatNam", type number},
				            {"PhuongThucTraGoc", type text},
				            {"NgayTraGocDauTien", type date},
				            {"TanSuatTraGoc", type text},
				            {"TanSuatTraLai", type text},
				            {"NgayTraLaiDauTien", type date},
				            {"CoSoTinhLai", Int64.Type},
				            {"GhiChu", type text}
				        },
				        "vi-VN"
				    )
				,
				    // Dư nợ dài hạn bắt đầu theo dõi từ ngày này.
				    MocTheoDoi = #date(2026, 9, 1),
				
				    LichGoc = Source{[Item="tblLichDaiHan", Kind="Table"]}[Data],
				
				    LichChuanChu = Table.TransformColumns(
				        LichGoc,
				        List.Transform(
				            {"MaCongTy", "MaNganHang", "MaKheUoc"},
				            (Cot) => {
				                Cot,
				                each if _ = null then null
				                     else Text.Trim(Text.From(_)),
				                type nullable text
				            }
				        )
				    ),
				
				    LichCoMa = Table.SelectRows(
				        LichChuanChu,
				        each [MaKheUoc] <> null and [MaKheUoc] <> ""
				    ),
				
				    LichDinhDang = Table.TransformColumnTypes(
				        LichCoMa,
				        {
				            {"NgayDenHan", type date},
				            {"DuNoTheoLichDauKy", Currency.Type}
				        },
				        "vi-VN"
				    ),
				
				    // Khoản đã có trong KHE_UOC không bổ sung lần nữa.
				    MaDaCo = List.Buffer(DinhDangDuLieu[MaKheUoc]),
				
				    LichCanBoSung = Table.SelectRows(
				        LichDinhDang,
				        each not List.Contains(MaDaCo, [MaKheUoc])
				    ),
				
				    GomTheoKhoan = Table.Group(
				        LichCanBoSung,
				        {"MaCongTy", "MaNganHang", "MaKheUoc"},
				        {
				            {
				                "DuNoBanDau",
				                each
				                    let
				                        SapXep = Table.Sort(
				                            _,
				                            {{"NgayDenHan", Order.Ascending}}
				                        ),
				                        DongDau = SapXep{0}
				                    in
				                        if DongDau[DuNoTheoLichDauKy] = null then
				                            error "Thiếu dư nợ đầu kỳ ở dòng lịch đầu tiên."
				                        else DongDau[DuNoTheoLichDauKy],
				                Currency.Type
				            },
				            {
				                "NgayDaoHan",
				                each List.Max([NgayDenHan]),
				                type date
				            }
				        }
				    ),
				
				    ThemMoc = Table.AddColumn(
				        GomTheoKhoan,
				        "NgayBatDauTheoDoi",
				        each MocTheoDoi,
				        type date
				    ),
				
				    ThemPhuongThuc = Table.AddColumn(
				        ThemMoc,
				        "PhuongThucTraGoc",
				        each "THEO_LICH",
				        type text
				    ),
				
				    // Các cột giải ngân và lãi suất của dòng bổ sung để trống.
				    // Không biến dư nợ ban đầu thành khoản vay mới.
				    GopDanhMuc = Table.Combine(
				        {DinhDangDuLieu, ThemPhuongThuc}
				    ),
				
				    KetQua = Table.TransformColumnTypes(
				        GopDanhMuc,
				        {
				            {"NgayNhanNo", type date},
				            {"NgayDaoHan", type date},
				            {"SoTienVay", Int64.Type},
				            {"DuNoBanDau", Currency.Type},
				            {"NgayBatDauTheoDoi", type date}
				        }
				    )
				in
				    KetQua

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

