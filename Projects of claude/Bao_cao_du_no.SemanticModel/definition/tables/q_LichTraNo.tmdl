		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 258aef90-a5f9-4000-8e78-f0dcfbe7a46b
		summarizeBy: none
		sourceColumn: NgayDenHan

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column TuNgayTinhLai
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 512cd07e-4834-484a-9ff7-7a34f053e25e
		summarizeBy: none
		sourceColumn: TuNgayTinhLai

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column SoNgayTinhLai
		dataType: int64
		formatString: 0
		lineageTag: 1de12ee0-31f4-44ba-9779-1af326055301
		summarizeBy: sum
		sourceColumn: SoNgayTinhLai

		annotation SummarizationSetBy = Automatic

	column GocPhaiTra
		dataType: int64
		formatString: #,0
		lineageTag: 776a7feb-312d-491c-955a-7f1045c2fccc
		summarizeBy: sum
		sourceColumn: GocPhaiTra

		annotation SummarizationSetBy = Automatic

	column LaiPhiDuKien
		dataType: int64
		formatString: #,0
		lineageTag: 92fa6fae-556e-4bdd-aa33-92857eaa3a40
		summarizeBy: sum
		sourceColumn: LaiPhiDuKien

		annotation SummarizationSetBy = Automatic

	column TongPhaiTra
		dataType: int64
		formatString: #,0
		lineageTag: 9bf826ae-0f91-47a8-9f8d-83beb8749670
		summarizeBy: sum
		sourceColumn: TongPhaiTra

		annotation SummarizationSetBy = Automatic

	column NguonLich
		dataType: string
		lineageTag: cda390c5-a6bc-4340-ba8b-b37f70cc1c0f
		summarizeBy: none
		sourceColumn: NguonLich

		annotation SummarizationSetBy = Automatic

	partition q_LichTraNo = m
		mode: import
		source =
				let
				    // 1. NGUỒN
				    KheUoc = tblKheUoc,
				    LichNhap = tblLichDaiHan,
				    Khoa = {"MaCongTy", "MaNganHang", "MaKheUoc"},
				
				    KieuLich = type table [
				        KyTraNo = Int64.Type,
				        NgayDenHan = date,
				        TuNgayTinhLai = nullable date,
				        SoNgayTinhLai = nullable number,
				        GocPhaiTra = nullable number,
				        LaiPhiDuKien = nullable number,
				        TongPhaiTra = nullable number,
				        NguonLich = text
				    ],
				
				    // 2. LỊCH NHẬP TAY
				    ChonLichNhap = Table.SelectColumns(
				        LichNhap,
				        Khoa & {
				            "KyTraNo",
				            "NgayDenHan",
				            "GocPhaiTra",
				            "TongPhaiTra"
				        }
				    ),
				
				    LaiPhiLichNhap = Table.AddColumn(
				        ChonLichNhap,
				        "LaiPhiDuKien",
				        each
				            if [TongPhaiTra] = null or [GocPhaiTra] = null
				            then null
				            else [TongPhaiTra] - [GocPhaiTra],
				        type nullable number
				    ),
				
				    TuNgayLichNhap = Table.AddColumn(
				        LaiPhiLichNhap,
				        "TuNgayTinhLai",
				        each null,
				        type nullable date
				    ),
				
				    SoNgayLichNhap = Table.AddColumn(
				        TuNgayLichNhap,
				        "SoNgayTinhLai",
				        each null,
				        type nullable number
				    ),
				
				    NguonLichNhap = Table.AddColumn(
				        SoNgayLichNhap,
				        "NguonLich",
				        each "NHAP_TAY",
				        type text
				    ),
				
				    // 3. CHỈ TỰ SINH CHO KHOẢN CHƯA CÓ LỊCH NHẬP TAY
				    ChuaCoLichNhap = Table.NestedJoin(
				        KheUoc,
				        Khoa,
				        LichNhap,
				        Khoa,
				        "LichDaNhap",
				        JoinKind.LeftAnti
				    ),
				
				    // 4. HÀM SINH LỊCH CHO MỘT KHẾ ƯỚC
				    TaoLich = (r as record) as table =>
				        let
				            MaKU = r[MaKheUoc],
				            NganHang = r[MaNganHang],
				            NhanNo = r[NgayNhanNo],
				            DaoHan = r[NgayDaoHan],
				            SoTien = r[SoTienVay],
				            LaiSuat = r[LaiSuatNam],
				            CoSo = r[CoSoTinhLai],
				            PhuongThuc = r[PhuongThucTraGoc],
				            TanSuat = r[TanSuatTraLai],
				            NgayNhap = r[NgayTraLaiDauTien],
				
				            NgayCoDinh =
				                if NganHang = "LPBank" then 25
				                else if NganHang = "VPBank" then 15
				                else if NganHang = "HDBank" then
				                    if MaKU = "Thấu chi HDBank" then 15 else 20
				                else null,
				
				            NgayDau =
				                if NgayNhap <> null then NgayNhap
				                else if NgayCoDinh = null or NhanNo = null then null
				                else
				                    let
				                        NgayTrongThang = #date(
				                            Date.Year(NhanNo),
				                            Date.Month(NhanNo),
				                            NgayCoDinh
				                        )
				                    in
				                        if NgayTrongThang > NhanNo then
				                            NgayTrongThang
				                        else
				                            Date.AddMonths(NgayTrongThang, 1),
				
				            BuocThang =
				                if TanSuat = "THANG" then 1
				                else if TanSuat = "QUY" then 3
				                else if TanSuat = "6_THANG" then 6
				                else if TanSuat = "CUOI_KY" then 0
				                else
				                    error Error.Record(
				                        "TanSuatKhongHopLe",
				                        "Tần suất trả lãi không hợp lệ.",
				                        [MaKheUoc = MaKU, TanSuatTraLai = TanSuat]
				                    ),
				
				            NgayDinhKy =
				                if PhuongThuc <> "CUOI_KY" then
				                    error Error.Record(
				                        "ChuaCoLich",
				                        "Khoản này chưa có lịch nhập tay và chưa hỗ trợ tự sinh phương thức trả gốc này.",
				                        [MaKheUoc = MaKU, PhuongThucTraGoc = PhuongThuc]
				                    )
				                else if NhanNo = null or DaoHan = null then
				                    error Error.Record(
				                        "ThieuNgay",
				                        "Thiếu ngày nhận nợ hoặc ngày đáo hạn.",
				                        [MaKheUoc = MaKU]
				                    )
				                else if DaoHan <= NhanNo then
				                    error Error.Record(
				                        "NgayKhongHopLe",
				                        "Ngày đáo hạn phải sau ngày nhận nợ.",
				                        [MaKheUoc = MaKU]
				                    )
				                else if SoTien = null then
				                    error Error.Record(
				                        "ThieuSoTien",
				                        "Thiếu số tiền vay.",
				                        [MaKheUoc = MaKU]
				                    )
				                else if SoTien <= 0 then
				                    error Error.Record(
				                        "SoTienKhongHopLe",
				                        "Số tiền vay phải lớn hơn 0.",
				                        [MaKheUoc = MaKU]
				                    )
				                else if BuocThang = 0 then
				                    {}
				                else if NgayDau = null then
				                    error Error.Record(
				                        "ThieuNgayTraLai",
				                        "Cần nhập ngày trả lãi đầu tiên cho khế ước này.",
				                        [MaKheUoc = MaKU, MaNganHang = NganHang]
				                    )
				                else if NgayDau <= NhanNo then
				                    error Error.Record(
				                        "NgayTraLaiKhongHopLe",
				                        "Ngày trả lãi đầu tiên phải sau ngày nhận nợ.",
				                        [MaKheUoc = MaKU]
				                    )
				                else
				                    List.Generate(
				                        () => 0,
				                        (i) => Date.AddMonths(
				                            NgayDau, i * BuocThang
				                        ) < DaoHan,
				                        (i) => i + 1,
				                        (i) => Date.AddMonths(
				                            NgayDau, i * BuocThang
				                        )
				                    ),
				
				            // Kỳ cuối luôn ở ngày đáo hạn, không tạo trùng ngày
				            CacNgay = NgayDinhKy & {DaoHan},
				
				            CacKy = List.Transform(
				                List.Positions(CacNgay),
				                (i) =>
				                    let
				                        TuNgay =
				                            if i = 0 then NhanNo
				                            else CacNgay{i - 1},
				
				                        DenNgay = CacNgay{i},
				                        SoNgay = Duration.Days(DenNgay - TuNgay),
				
				                        Goc =
				                            if DenNgay = DaoHan then SoTien
				                            else 0,
				
				                        Lai =
				                            if LaiSuat = null or CoSo = null then null
				                            else if LaiSuat < 0 or not List.Contains({360, 365}, CoSo) then
				                                error Error.Record(
				                                    "LaiSuatKhongHopLe",
				                                    "Kiểm tra lãi suất và cơ sở tính lãi 360/365.",
				                                    [MaKheUoc = MaKU]
				                                )
				                            else
				                                Number.Round(
				                                    SoTien * LaiSuat * SoNgay / CoSo,
				                                    0,
				                                    RoundingMode.AwayFromZero
				                                )
				                    in
				                        [
				                            KyTraNo = i + 1,
				                            NgayDenHan = DenNgay,
				                            TuNgayTinhLai = TuNgay,
				                            SoNgayTinhLai = SoNgay,
				                            GocPhaiTra = Goc,
				                            LaiPhiDuKien = Lai,
				                            TongPhaiTra =
				                                if Lai = null then null else Goc + Lai,
				                            NguonLich = "TU_SINH_CUOI_KY"
				                        ]
				            )
				        in
				            Table.FromRecords(CacKy, KieuLich),
				
				    // 5. TỰ SINH LỊCH
				    ThemLich = Table.AddColumn(
				        ChuaCoLichNhap,
				        "Lich",
				        each TaoLich(_),
				        KieuLich
				    ),
				
				    ChonCotTuSinh = Table.SelectColumns(
				        ThemLich,
				        Khoa & {"Lich"}
				    ),
				
				    MoRongLich = Table.ExpandTableColumn(
				        ChonCotTuSinh,
				        "Lich",
				        {
				            "KyTraNo",
				            "NgayDenHan",
				            "TuNgayTinhLai",
				            "SoNgayTinhLai",
				            "GocPhaiTra",
				            "LaiPhiDuKien",
				            "TongPhaiTra",
				            "NguonLich"
				        }
				    ),
				
				    // 6. GỘP THÀNH MỘT BẢNG LỊCH
				    GopLich = Table.Combine({NguonLichNhap, MoRongLich}),
				
				    DinhDang = Table.TransformColumnTypes(
				        GopLich,
				        {
				            {"MaCongTy", type text},
				            {"MaNganHang", type text},
				            {"MaKheUoc", type text},
				            {"KyTraNo", Int64.Type},
				            {"NgayDenHan", type date},
				            {"TuNgayTinhLai", type date},
				            {"SoNgayTinhLai", Int64.Type},
				            {"GocPhaiTra", Int64.Type},
				            {"LaiPhiDuKien", Int64.Type},
				            {"TongPhaiTra", Int64.Type},
				            {"NguonLich", type text}
				        },
				        "vi-VN"
				    ),
				
				    SapCot = Table.ReorderColumns(
				        DinhDang,
				        {
				            "MaCongTy",
				            "MaNganHang",
				            "MaKheUoc",
				            "KyTraNo",
				            "NgayDenHan",
				            "TuNgayTinhLai",
				            "SoNgayTinhLai",
				            "GocPhaiTra",
				            "LaiPhiDuKien",
				            "TongPhaiTra",
				            "NguonLich"
				        }
				    ),
				
				    KetQua = Table.Sort(
				        SapCot,
				        {
				            {"NgayDenHan", Order.Ascending},
				            {"MaCongTy", Order.Ascending},
				            {"MaNganHang", Order.Ascending},
				            {"MaKheUoc", Order.Ascending}
				        }
				    )
				in
				    KetQua

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

