table q_LichTraNo
	lineageTag: 02838121-6808-4733-8bd3-afe534e705cd

	measure SoDongLichTrongKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			RETURN
			    CALCULATE(
			        COUNTROWS(q_LichTraNo),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] >= TuNgay),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] < DenNgay + 1)
			    )
		formatString: 0
		lineageTag: 8cb44889-b37a-469b-a8b4-9a30070dc032

	measure GocDenHanTrongKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			RETURN
			    CALCULATE(
			        SUM(q_LichTraNo[GocPhaiTra]),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] >= TuNgay),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] < DenNgay + 1)
			    )
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: fc2afdf4-a68b-438e-b994-4e80bde81104

	measure LaiPhiDenHanTrongKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			RETURN
			    CALCULATE(
			        SUM(q_LichTraNo[LaiPhiDuKien]),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] >= TuNgay),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] < DenNgay + 1)
			    )
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 6bb7194e-febb-47ed-adde-9bd6c02f2890

	measure TongDenHanTrongKy =
			
			[GocDenHanTrongKy] + [LaiPhiDenHanTrongKy]
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: a18d0a3e-1215-414a-bd28-9c7ca68e2d01

	/// Phần gốc của các kỳ đến hạn trong kỳ báo cáo chưa được thanh toán tính đến cuối kỳ (nghĩa vụ đến hạn, không phải dư nợ).
	measure GocConPhaiTraCuoiKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			
			VAR CacKyTrongKhoang =
			    CALCULATETABLE(
			        SUMMARIZE(
			            q_LichTraNo,
			            q_LichTraNo[MaKheUoc],
			            q_LichTraNo[NgayDenHan],
			            "GocCuaKy", SUM(q_LichTraNo[GocPhaiTra])
			        ),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] >= TuNgay),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] < DenNgay + 1)
			    )
			
			RETURN
			    SUMX(
			        CacKyTrongKhoang,
			        VAR MaDangTinh = q_LichTraNo[MaKheUoc]
			        VAR NgayKy = q_LichTraNo[NgayDenHan]
			        VAR GocKy = [GocCuaKy]
			
			        VAR MocTheoDoi =
			            LOOKUPVALUE(
			                tblKheUoc[NgayBatDauTheoDoi],
			                tblKheUoc[MaKheUoc], MaDangTinh
			            )
			
			        VAR NgayBatDau =
			            COALESCE(MocTheoDoi, DATE(1900, 1, 1))
			
			        VAR GocCacKyTruoc =
			            SUMX(
			                FILTER(
			                    ALL(q_LichTraNo),
			                    q_LichTraNo[MaKheUoc] = MaDangTinh
			                        && q_LichTraNo[NgayDenHan] >= NgayBatDau
			                        && q_LichTraNo[NgayDenHan] < NgayKy
			                ),
			                q_LichTraNo[GocPhaiTra]
			            )
			
			        VAR GocDaThanhToan =
			            CALCULATE(
			                SUM(q_TraNo[GocDaTra]),
			                REMOVEFILTERS(q_LichTraNo),
			                KEEPFILTERS(q_TraNo[MaKheUoc] = MaDangTinh),
			                q_TraNo[NgayGiaoDich] >= NgayBatDau,
			                q_TraNo[NgayGiaoDich] < DenNgay + 1
			            )
			
			        VAR TienConDeTraKyNay =
			            MAX(
			                0,
			                COALESCE(GocDaThanhToan, 0)
			                    - COALESCE(GocCacKyTruoc, 0)
			            )
			
			        RETURN
			            IF(
			                GocKy > 0 && NgayKy >= NgayBatDau,
			                MAX(0, GocKy - TienConDeTraKyNay),
			                BLANK()
			            )
			    )
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 35ac0812-d207-4f09-9665-7926279465b1

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	measure GocDenHanTrongKyTrieu =
			
			DIVIDE([GocDenHanTrongKy], 1000000)
		formatString: #,0\ "triệu"
		lineageTag: 6f7e8d9c-0b1a-4234-95c6-e7f8a9b0c108

	measure LaiPhiDenHanTrongKyTrieu =
			
			DIVIDE([LaiPhiDenHanTrongKy], 1000000)
		formatString: #,0\ "triệu"
		lineageTag: 8a9b0c1d-2e3f-4456-a7b8-c9d0e1f2a309

	measure GocDenHanTrongKyTyDong =
			
			[GocDenHanTrongKy]
		formatString: #,0,,,.000\ "tỷ";-#,0,,,.000\ "tỷ";0\ "tỷ"
		lineageTag: 6f7a8b9c-0d1e-4f2a-b3c4-5d6e7f8a9b02

	measure LaiPhiDenHanTrongKyTyDong =
			
			[LaiPhiDenHanTrongKy]
		formatString: #,0,,,.000\ "tỷ";-#,0,,,.000\ "tỷ";0\ "tỷ"
		lineageTag: 7a8b9c0d-1e2f-4a3b-c4d5-6e7f8a9b0c13

	measure TongDenHanTrongKyTyDong =
			
			[TongDenHanTrongKy]
		formatString: #,0,,,.000\ "tỷ";-#,0,,,.000\ "tỷ";0\ "tỷ"
		lineageTag: 8b9c0d1e-2f3a-4b4c-d5e6-7f8a9b0c1d24

	measure GocConPhaiTraTyDong =
			
			IF(ISEMPTY(tblKheUoc), BLANK(), COALESCE([GocConPhaiTraCuoiKy], 0))
		formatString: #,0,,,.000\ "tỷ";-#,0,,,.000\ "tỷ";0\ "tỷ"
		lineageTag: 9c0d1e2f-3a4b-4c5d-e6f7-8a9b0c1d2e35

	measure NgayDenHanGanNhatTrongKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			RETURN
			    CALCULATE(
			        MIN(q_LichTraNo[NgayDenHan]),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] >= TuNgay),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] < DenNgay + 1)
			    )
		formatString: dd/MM/yyyy
		lineageTag: 5d6e7f8a-9b0c-4dfb-f17c-3b4c5d6e7f84

	measure SoKheUocDenHanTrongKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(q_LichTraNo[MaKheUoc]),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] >= TuNgay),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] < DenNgay + 1)
			    )
		formatString: 0
		lineageTag: 6e7f8a9b-0c1d-4eac-a28d-4c5d6e7f8a95

	/// Mức lệch giữa lãi dự kiến và lãi thực trả vẫn coi là đã trả đủ. Sửa số ở đây để đổi ngưỡng cho toàn báo cáo.
	measure NguongLechLai = 5000000
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 1d2e3f4a-5b6c-4df1-f7d2-9b0c1d2e3f4a

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	/// Lãi của kỳ chưa thanh toán. Kỳ đã tất toán hết gốc thì coi như lãi cũng xong; kỳ chỉ có lãi thì so tiền theo thứ tự kỳ, lệch trong NguongLechLai vẫn coi là đã trả.
	measure LaiPhiConPhaiTraCuoiKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			VAR Nguong = [NguongLechLai]
			VAR CacKyTrongKhoang =
			    CALCULATETABLE(
			        SUMMARIZE(
			            q_LichTraNo,
			            q_LichTraNo[MaKheUoc],
			            q_LichTraNo[NgayDenHan],
			            "GocCuaKy", SUM(q_LichTraNo[GocPhaiTra]),
			            "LaiCuaKy", SUM(q_LichTraNo[LaiPhiDuKien])
			        ),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] >= TuNgay),
			        KEEPFILTERS(q_LichTraNo[NgayDenHan] < DenNgay + 1)
			    )
			RETURN
			    SUMX(
			        CacKyTrongKhoang,
			        VAR MaDangTinh = q_LichTraNo[MaKheUoc]
			        VAR NgayKy = q_LichTraNo[NgayDenHan]
			        VAR GocKy = [GocCuaKy]
			        VAR LaiKy = [LaiCuaKy]
			        VAR NgayBatDau =
			            COALESCE(
			                LOOKUPVALUE(tblKheUoc[NgayBatDauTheoDoi], tblKheUoc[MaKheUoc], MaDangTinh),
			                DATE(1900, 1, 1)
			            )
			        VAR CacKyTruoc =
			            FILTER(
			                ALL(q_LichTraNo),
			                q_LichTraNo[MaKheUoc] = MaDangTinh
			                    && q_LichTraNo[NgayDenHan] >= NgayBatDau
			                    && q_LichTraNo[NgayDenHan] < NgayKy
			            )
			        VAR GocCacKyTruoc = SUMX(CacKyTruoc, q_LichTraNo[GocPhaiTra])
			        VAR GocDaThanhToan =
			            CALCULATE(
			                SUM(q_TraNo[GocDaTra]),
			                REMOVEFILTERS(q_LichTraNo),
			                KEEPFILTERS(q_TraNo[MaKheUoc] = MaDangTinh),
			                q_TraNo[NgayGiaoDich] >= NgayBatDau,
			                q_TraNo[NgayGiaoDich] < DenNgay + 1
			            )
			        VAR GocConCuaKy =
			            MAX(0, GocKy - MAX(0, COALESCE(GocDaThanhToan, 0) - COALESCE(GocCacKyTruoc, 0)))
			        // Lãi chỉ khớp trong cửa sổ của kỳ này: sau kỳ lãi liền trước đến hết kỳ báo cáo.
			        // Không cho phần trả dư của kỳ trước chảy sang che kỳ này.
			        VAR NgayKyLaiTruoc =
			            MAXX(
			                FILTER(CacKyTruoc, q_LichTraNo[LaiPhiDuKien] > 0),
			                q_LichTraNo[NgayDenHan]
			            )
			        VAR MocCuaSo = COALESCE(NgayKyLaiTruoc + 1, NgayBatDau)
			        VAR LaiTraTrongCuaSo =
			            CALCULATE(
			                SUM(q_TraNo[LaiPhiDaTra]),
			                REMOVEFILTERS(q_LichTraNo),
			                KEEPFILTERS(q_TraNo[MaKheUoc] = MaDangTinh),
			                q_TraNo[NgayGiaoDich] >= MocCuaSo,
			                q_TraNo[NgayGiaoDich] < DenNgay + 1
			            )
			        VAR SoGiaoDichLaiTrongCuaSo =
			            CALCULATE(
			                COUNTROWS(q_TraNo),
			                REMOVEFILTERS(q_LichTraNo),
			                KEEPFILTERS(q_TraNo[MaKheUoc] = MaDangTinh),
			                q_TraNo[LaiPhiDaTra] > 0,
			                q_TraNo[NgayGiaoDich] >= MocCuaSo,
			                q_TraNo[NgayGiaoDich] < DenNgay + 1
			            )
			        VAR CoGiaoDichLai = COALESCE(SoGiaoDichLaiTrongCuaSo, 0) > 0
			        VAR LaiConCuaKy = MAX(0, LaiKy - COALESCE(LaiTraTrongCuaSo, 0))
			        RETURN
			            IF(
			                LaiKy > 0 && NgayKy >= NgayBatDau && NOT (GocKy > 0 && GocConCuaKy = 0),
			                // Ngưỡng lệch chỉ áp dụng khi đã có giao dịch trả lãi; chưa trả đồng nào thì luôn là chưa thanh toán.
			                IF(NOT CoGiaoDichLai, LaiKy, IF(LaiConCuaKy > Nguong, LaiConCuaKy))
			            )
			    )
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 7f8a9b0c-1d2e-4fbd-b39e-5d6e7f8a9b06

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	/// = 1 khi kỳ còn gốc hoặc lãi chưa thanh toán. Dùng làm bộ lọc dòng.
	measure KyChuaThanhToan =
			
			IF(
			    COALESCE([GocConPhaiTraCuoiKy], 0) > 0
			        || COALESCE([LaiPhiConPhaiTraCuoiKy], 0) > 0,
			    1
			)
		formatString: 0
		lineageTag: 8a9b0c1d-2e3f-4ace-c4af-6e7f8a9b0c17

	measure SoNgayQuaHanKy =
			
			IF(
			    HASONEVALUE(q_LichTraNo[NgayDenHan]),
			    VAR Moc = [NgayMocTinhHan]
			    VAR NgayKy = MAX(q_LichTraNo[NgayDenHan])
			    RETURN IF(NgayKy < Moc, INT(Moc - NgayKy))
			)
		formatString: #,0
		lineageTag: 9b0c1d2e-3f4a-4bdf-d5b0-7f8a9b0c1d28

	measure SoNgayConDenHanKy =
			
			IF(
			    HASONEVALUE(q_LichTraNo[NgayDenHan]),
			    VAR Moc = [NgayMocTinhHan]
			    VAR NgayKy = MAX(q_LichTraNo[NgayDenHan])
			    RETURN IF(NgayKy >= Moc, INT(NgayKy - Moc))
			)
		formatString: #,0
		lineageTag: 0c1d2e3f-4a5b-4ce0-e6c1-8a9b0c1d2e39

	/// Gốc đã trả hết thì coi như kỳ đã thanh toán (không xét lãi); kỳ chỉ có lãi thì lệch trong NguongLechLai vẫn tính là đã thanh toán.
	measure TrangThaiThanhToanKy =
			
			IF(
			    COALESCE([KyChuaThanhToan], 0) > 0,
			    "Chưa thanh toán",
			    "Đã thanh toán"
			)
		lineageTag: 2e3f4a5b-6c7d-4a02-b8e3-0c1d2e3f4a5b

	measure MauTrangThaiThanhToanKy =
			
			IF(COALESCE([KyChuaThanhToan], 0) > 0, "#B91C1C", "#15803D")
		lineageTag: 3f4a5b6c-7d8e-4b13-c9f4-1d2e3f4a5b6c

	column MaCongTy
		dataType: string
