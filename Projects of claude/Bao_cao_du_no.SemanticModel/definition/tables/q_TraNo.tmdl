table q_TraNo
	lineageTag: 769a3f5f-c6c2-44e0-8c6e-826b4dd4eb9f

	measure GocDaTraTrongKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			RETURN
			    IF(
			        ISEMPTY(tblKheUoc),
			        BLANK(),
			        COALESCE(
			            CALCULATE(
			                SUM(q_TraNo[GocDaTra]),
			                q_TraNo[NgayGiaoDich] >= TuNgay,
			                q_TraNo[NgayGiaoDich] < DenNgay + 1
			            ),
			            0
			        )
			    )
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 87402013-33f8-4b96-ad0f-5437b931a3dc

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	measure LaiPhiDaTraTrongKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			RETURN
			    IF(
			        ISEMPTY(tblKheUoc),
			        BLANK(),
			        COALESCE(
			            CALCULATE(
			                SUM(q_TraNo[LaiPhiDaTra]),
			                q_TraNo[NgayGiaoDich] >= TuNgay,
			                q_TraNo[NgayGiaoDich] < DenNgay + 1
			            ),
			            0
			        )
			    )
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 01fddb5b-2470-4fdd-99e2-c615c3b663b7

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	measure TongDaTraTrongKy =
			
			[GocDaTraTrongKy] + [LaiPhiDaTraTrongKy]
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 3d551602-a8b6-44aa-b777-448b2c406dc0

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	measure SoDongTraNoTrongKy =
			
			VAR TuNgay = MIN(NgayBaoCao[Date])
			VAR DenNgay = MAX(NgayBaoCao[Date])
			RETURN
			    CALCULATE(
			        COUNTROWS(q_TraNo),
			        KEEPFILTERS(q_TraNo[NgayGiaoDich] >= TuNgay),
			        KEEPFILTERS(q_TraNo[NgayGiaoDich] < DenNgay + 1)
			    )
		formatString: 0
		lineageTag: a34ac88d-6d8a-4326-b61e-b804168d5c77

	measure LaiPhiDaTraTrongKyTyDong =
			
			[LaiPhiDaTraTrongKy]
		formatString: #,0,,,.000\ "tỷ";-#,0,,,.000\ "tỷ";0\ "tỷ"
		lineageTag: 0d1e2f3a-4b5c-4d6e-f7a8-9b0c1d2e3f46

	/// Giao dịch trả nợ (chủ yếu lấy tự động từ sao kê) có mã khế ước không tồn tại trong tblKheUoc — không được trừ vào dư nợ nào.
	measure SoGiaoDichKhongKhopKheUoc =
			
			CALCULATE(
			    COUNTROWS(q_TraNo),
			    ISBLANK(tblKheUoc[MaKheUoc])
			)
		formatString: 0
		lineageTag: 1e2f3a4b-5c6d-4e7f-a8b9-0c1d2e3f4a57

	measure GocDaTraKhongKhopKheUoc =
			
			CALCULATE(
			    SUM(q_TraNo[GocDaTra]),
			    ISBLANK(tblKheUoc[MaKheUoc])
			)
		formatString: #,0.###############\ "₫";-#,0.###############\ "₫";#,0.###############\ "₫"
		lineageTag: 2f3a4b5c-6d7e-4f8a-b9c0-1d2e3f4a5b68

		annotation PBI_FormatHint = {"currencyCulture":"vi-VN"}

	column IDGiaoDich
